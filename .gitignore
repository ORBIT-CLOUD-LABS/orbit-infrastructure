.DS_Store

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
!*.tfvars.example

# Terraform pg backend 접속 정보 (비밀번호 포함)
terraform/environments/*/backend-config/*.conf

# cloud-init 생성물
**/.generated/

# Terraform이 apply 시 생성하는 Ansible inventory
ansible/inventory/lab/hosts.ini
