.DS_Store
__pycache__/

# GitOps 인증정보는 암호화 여부와 관계없이 로컬에만 보관한다.
ansible/secrets/argocd-vault.yml
ansible/secrets/argocd-vault.yml.*
!ansible/secrets/argocd-vault.yml.example

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
!*.tfvars.example

# Terraform pg backend 접속 정보 (비밀번호 포함)
terraform/**/backend-config/*.conf

# cloud-init 생성물
**/.generated/

# Terraform이 apply 시 생성하는 Ansible inventory
ansible/inventory/lab/hosts.ini

# Vagrant local machine state
**/.vagrant/
