# 비밀값 예시 파일 — 실제 값은 secrets/vault.yml에 넣고 반드시 암호화한다.
#   cp secrets/vault.yml.example secrets/vault.yml
#   nano secrets/vault.yml                 # 값 채우기
#   ansible-vault encrypt secrets/vault.yml
#   ansible-playbook site.yml --ask-vault-pass
# 암호화된 vault.yml은 Git에 올려도 된다. vault 비밀번호는 Slack DM으로만 공유.

vault_vehicle_db_password: "CHANGE_ME_8+chars"
vault_campaign_db_password: "CHANGE_ME_8+chars"
vault_grafana_admin_password: "CHANGE_ME_8+chars"
vault_slack_webhook: ""        # https://hooks.slack.com/services/... (비우면 Slack 알림 없음)
