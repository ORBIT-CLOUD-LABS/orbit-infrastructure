# 이 파일을 참고해서 astra에서 ansible-vault create inventory/group_vars/all/vault.yml 로 만듦. vault.yml은 Git에 안 올림 (.gitignore)
vault_wifi_psk: "<와이파이 비밀번호>"
# VM의 orbit 계정 sudo 비밀번호 해시. 노드와 같은 비밀번호로: openssl passwd -6
vault_orbit_password_hash: "$6$..."
# HashiCorp Vault 비상 계정(userpass) 비밀번호. 계정을 처음 만들 때만 씀
vault_breakglass1_password: "<비상 계정 1 비밀번호>"
vault_breakglass2_password: "<비상 계정 2 비밀번호>"
# 개인 계정 초기 sudo 비밀번호 해시. 개인별 임시 비밀번호를 openssl passwd -6의 숨김 프롬프트로 해시화
# 담당자가 임시 비밀번호를 개인별 안전한 경로로 전달. 본인은 인증서 로그인 준비 후 passwd로 변경
# 실제 해시도 암호화 vault.yml에만 기록. 계정 최초 생성에만 적용하며 이후 비밀번호를 덮어쓰지 않음
vault_personal_accounts_password_hashes:
  hyn128: "$6$..."
  sungahbak: "$6$..."
  chuchuu22: "$6$..."
  jyvnee: "$6$..."
  xoruddl: "$6$..."
# Vault 스냅샷 백업용 AWS 액세스 키 (IAM 사용자 svc-vault-backup) 및 사설 S3 인터페이스 엔드포인트 URL. docs/aws.md 참조
# vault VM의 /etc/vault.d/snapshot-aws.env (root 0600)로만 내려간다. 평문은 여기에도 두지 않음
vault_snapshot_aws_access_key_id: "AKIA..."
vault_snapshot_aws_secret_access_key: "<시크릿 액세스 키>"
vault_aws_s3_vpce_endpoint_url: "https://bucket.<vpce-id>.s3.ap-northeast-2.vpce.amazonaws.com"
# AWS Site-to-Site VPN 터널 주소·사전 공유 키 (aws/terraform output -raw vpn_tunnel1_* 로 조회). docs/fw.md 참조
vault_aws_vpn_tunnel1_ip: "<터널 1 외부 IP>"
vault_aws_vpn_tunnel2_ip: "<터널 2 외부 IP>"
vault_aws_vpn_tunnel1_psk: "<터널 1 사전 공유 키>"
vault_aws_vpn_tunnel2_psk: "<터널 2 사전 공유 키>"
