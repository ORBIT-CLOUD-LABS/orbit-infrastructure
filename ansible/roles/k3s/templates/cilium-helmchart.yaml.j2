# {{ ansible_managed }}
# k3s가 시작할 때 helm-controller가 이 파일을 보고 Cilium을 설치함
# bootstrap: CNI가 없을 때도 설치 작업이 돌도록 호스트 네트워크로 실행
# 4개 클러스터가 같은 Cilium CA(tls.ca)를 써야 Cluster Mesh와 Hubble Relay가 서로를 믿음
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: cilium
  namespace: kube-system
spec:
  repo: https://helm.cilium.io/
  chart: cilium
  version: {{ cilium_version }}
  targetNamespace: kube-system
  bootstrap: true
  valuesContent: |-
    cluster:
      name: {{ k3s_cluster_name }}
      id: {{ k3s_cluster_id }}
    ipam:
      operator:
        clusterPoolIPv4PodCIDRList:
          - {{ k3s_pod_cidr }}
    # 모든 노드가 server라 각자 자기 API 서버로 붙음. 한 대가 멈춰도 나머지는 영향 없음
    k8sServiceHost: 127.0.0.1
    k8sServicePort: 6443
    operator:
      replicas: 2
    tls:
      ca:
        cert: {{ hostvars[groups['k3s'][0]].k3s_cilium_ca.crt | b64encode }}
        key: {{ hostvars[groups['k3s'][0]].k3s_cilium_ca.key | b64encode }}
    hubble:
      relay:
        enabled: true
{% if k3s_cluster_name == k3s_hubble_ui_cluster %}
      ui:
        enabled: true
        service:
          type: NodePort
          nodePort: {{ k3s_hubble_ui_port }}
{% endif %}
    clustermesh:
      useAPIServer: true
      apiserver:
        service:
          type: NodePort
          nodePort: {{ k3s_clustermesh_port }}
      config:
        enabled: true
        clusters:
{% for g in k3s_cluster_groups if g != k3s_cluster_group %}
          - name: {{ hostvars[groups[g][0]].k3s_cluster_name }}
            ips:
              - {{ hostvars[groups[g][0]].k3s_vip }}
            port: {{ k3s_clustermesh_port }}
{% endfor %}
