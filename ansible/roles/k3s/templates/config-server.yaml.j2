# {{ ansible_managed }}
# k3s 서버 (control plane): {{ inventory_hostname }}
node-ip: {{ lan_ip }}
advertise-address: {{ lan_ip }}
tls-san:
  - {{ lan_ip }}
  - {{ inventory_hostname }}
cluster-init: true                  # 내장 etcd (SQLite 대신). 데이터는 /var/lib/rancher (NVMe)
cluster-cidr: {{ k3s_pod_cidr }}
service-cidr: {{ k3s_service_cidr }}
flannel-backend: none               # CNI는 Cilium
disable-network-policy: true        # NetworkPolicy도 Cilium이
node-taint:
  - node-role.kubernetes.io/control-plane=true:NoSchedule   # 일반 파드는 워커에만
write-kubeconfig-mode: "0600"
