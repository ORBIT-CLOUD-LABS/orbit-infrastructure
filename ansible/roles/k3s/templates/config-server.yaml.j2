# {{ ansible_managed }}
# k3s 서버 (control plane): {{ inventory_hostname }}
node-ip: {{ lan_ip }}
advertise-address: {{ lan_ip }}
tls-san:
  - {{ lan_ip }}
  - {{ inventory_hostname }}
# 데이터 저장소는 k3s 기본값 SQLite (cluster-init 없음). /var/lib/rancher/k3s/server/db/state.db (NVMe)
cluster-cidr: {{ k3s_pod_cidr }}
service-cidr: {{ k3s_service_cidr }}
flannel-backend: none               # CNI는 Cilium
disable-network-policy: true        # NetworkPolicy도 Cilium이
node-taint:
  - {{ k3s_cp_taint }}   # 일반 파드는 워커에만
write-kubeconfig-mode: "0600"
