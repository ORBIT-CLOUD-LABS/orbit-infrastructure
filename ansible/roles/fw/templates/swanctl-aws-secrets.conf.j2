# {{ ansible_managed }}
# AWS Site-to-Site VPN 사전 공유 키 (root:root 0600, ansible-vault에서 주입)
secrets {
    ike-aws-tunnel-1 {
        id-remote = {{ fw_vpn_tunnel1_ip }}
        secret = "{{ vault_aws_vpn_tunnel1_psk }}"
    }
{% if fw_vpn_tunnel2_ip | length > 0 %}
    ike-aws-tunnel-2 {
        id-remote = {{ fw_vpn_tunnel2_ip }}
        secret = "{{ vault_aws_vpn_tunnel2_psk }}"
    }
{% endif %}
}
