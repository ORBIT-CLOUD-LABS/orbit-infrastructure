#!/usr/bin/env bash

# 명령 실패, 미정의 변수 사용, pipeline 중간 실패를 모두 작업 실패로 처리한다.
set -Eeuo pipefail

# 이 스크립트가 만드는 파일은 기본적으로 소유자만 읽고 쓸 수 있게 한다.
umask 077

# Ansible 변수를 실제 실행에 사용할 셸 변수로 옮긴다.
database="{{ terraform_pg_database }}"
local_dir="{{ terraform_state_backup_local_dir }}"
passphrase_file="{{ terraform_state_backup_passphrase_file }}"
ssh_key="{{ terraform_state_backup_ssh_private_key }}"
known_hosts="{{ terraform_state_backup_known_hosts }}"
remote="{{ terraform_state_backup_remote_user }}@{{ terraform_state_backup_remote_host }}"
remote_dir="{{ terraform_state_backup_remote_dir }}"
retention_minutes="{{ terraform_state_backup_retention_days * 24 * 60 }}"

# 모든 호스트가 UTC를 사용하므로 파일명에도 UTC 시각을 넣는다.
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
filename="terraform_states-${timestamp}.dump.gpg"

# 평문 dump와 암호화 작업 파일은 재부팅 시 비워지는 /run에만 둔다.
work_dir="$(mktemp -d /run/orbit-state-backup.XXXXXX)"
dump_file="${work_dir}/terraform_states.dump"
encrypted_file="${work_dir}/${filename}"

# .partial은 쓰기가 끝나지 않은 파일을 정상 백업과 구분하기 위한 이름이다.
local_partial="${local_dir}/${filename}.partial"
local_final="${local_dir}/${filename}"

# 성공하거나 중간에 실패해도 /run의 평문 dump와 작업 파일을 삭제한다.
trap 'rm -rf -- "${work_dir}"' EXIT

# PostgreSQL 서비스 계정으로 DB 전체를 custom format으로 출력한다.
# 파일은 root 셸이 umask 077로 생성해 평문 dump 권한을 0600으로 제한한다.
runuser -u postgres -- pg_dump \
  --format=custom "${database}" > "${dump_file}"

# PostgreSQL 복구 도구가 dump 목차를 읽을 수 있어야 다음 단계로 진행한다.
pg_restore --list "${dump_file}" >/dev/null

# 임시 GPG 홈을 사용해 root 홈에 불필요한 GPG 상태를 남기지 않는다.
export GNUPGHOME="${work_dir}/gnupg"
install -d -m 0700 "${GNUPGHOME}"

# Vault에서 배치한 root 전용 파일로 비밀번호를 읽어 dump를 암호화한다.
gpg --batch --yes --pinentry-mode loopback \
  --passphrase-file "${passphrase_file}" \
  --symmetric --cipher-algo AES256 \
  --output "${encrypted_file}" "${dump_file}"

# ASTRA에도 .partial로 먼저 복사하고 완료 후 최종 파일명으로 바꾼다.
install -o root -g root -m 0600 \
  "${encrypted_file}" "${local_partial}"
mv -- "${local_partial}" "${local_final}"

# systemd가 사람 입력 없이 전용 키와 검증된 host key로 접속하게 한다.
ssh_options=(
  -i "${ssh_key}"
  -o IdentitiesOnly=yes
  -o UserKnownHostsFile="${known_hosts}"
  -o StrictHostKeyChecking=yes
  -o BatchMode=yes
)

# TERRA 전송 중에는 .partial을 사용한다.
scp "${ssh_options[@]}" "${local_final}" \
  "${remote}:${remote_dir}/${filename}.partial"

# 전송이 끝난 뒤 권한을 0600으로 고정하고 최종 파일명으로 바꾼다.
ssh "${ssh_options[@]}" "${remote}" \
  "chmod 0600 '${remote_dir}/${filename}.partial' && mv '${remote_dir}/${filename}.partial' '${remote_dir}/${filename}'"

# TERRA 전송까지 성공한 경우에만 ASTRA와 TERRA의 14일 초과 백업을 지운다.
find "${local_dir}" -maxdepth 1 -type f \
  -name 'terraform_states-*.dump.gpg' \
  -mmin "+${retention_minutes}" -delete
ssh "${ssh_options[@]}" "${remote}" \
  "find '${remote_dir}' -maxdepth 1 -type f -name 'terraform_states-*.dump.gpg' -mmin '+${retention_minutes}' -delete"

# journald에는 비밀번호나 DB 내용 없이 완료된 파일명만 남긴다.
echo "Terraform state backup completed: ${filename}"