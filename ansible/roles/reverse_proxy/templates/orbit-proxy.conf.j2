# {{ ansible_managed }}
# 내부 리버스 프록시 (astra). 서비스 이름을 보고 각 VM 포트로 넘김. 문서: docs/reverse-proxy.md
# {{ rproxy_listen_ip }}:{{ rproxy_port }}에서만 받음. 방화벽 ORBIT-PROXY가 lo, br0, tailscale0 밖에서 오는 443을 버림

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 모르는 이름은 응답 없이 끊음
server {
    listen {{ rproxy_listen_ip }}:{{ rproxy_port }} ssl default_server;
    ssl_certificate     {{ rproxy_cert }};
    ssl_certificate_key {{ rproxy_cert_key }};
    return 444;
}
{% for site in rproxy_sites %}

server {
    listen {{ rproxy_listen_ip }}:{{ rproxy_port }} ssl;
    server_name {{ site.name }}.{{ orbit_domain }};
    ssl_certificate     {{ rproxy_cert }};
    ssl_certificate_key {{ rproxy_cert_key }};

    location / {
        proxy_pass {{ site.upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
{% if site.upstream.startswith('https') %}
{% if site.verify | default(false) %}
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate {{ site.ca }};
        proxy_ssl_name {{ site.ssl_name }};
{% else %}
        proxy_ssl_verify off;
{% endif %}
{% endif %}
    }
}
{% endfor %}