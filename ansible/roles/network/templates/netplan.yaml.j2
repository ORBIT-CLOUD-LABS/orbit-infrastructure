# {{ ansible_managed }}
# 노드: {{ inventory_hostname }} ({{ net_role }}). 직접 고치지 말고 인벤토리를 고친 뒤 network 플레이북 실행
network:
  version: 2
  ethernets:
    orbit-lan:
      match:
        macaddress: "{{ lan_mac | lower }}"
      set-name: {{ lan_if }}
      dhcp4: false
{% if outer_bridge is defined and outer_if %}
    orbit-outer:
      # 바깥 구역 포트 (io 직결)
      match:
        macaddress: "{{ outer_mac | lower }}"
      set-name: {{ outer_if }}
      dhcp4: false
      optional: true
{% endif %}
  bridges:
    {{ lan_bridge }}:
      # VM이 내부망에 직접 붙는 가상 스위치. 유선 주소는 브리지가 가짐
      interfaces: [orbit-lan]
      dhcp4: false
      addresses:
        - {{ lan_ip }}/{{ lan_prefix }}
{% if old_lan_ip is defined %}
        - {{ old_lan_ip }}/{{ old_lan_net.split('/')[1] }}   # 옛 내부망. 옛 대역 정리 때 제거
{% endif %}
      nameservers:
        addresses: [{{ dns | join(', ') }}]
      routes:
        # 관측 구역은 같은 스위치에 있어 방화벽을 거치지 않고 직접 보냄. 출발지는 새 주소로 고정
        - to: {{ obs_net }}
          scope: link
          from: {{ lan_ip }}
{% if net_role == 'fw' %}
        - to: default
          via: {{ lan_gw }}
          metric: {{ metric_main }}
{% endif %}
      parameters:
        stp: false
        forward-delay: 0
{% if outer_bridge is defined %}
    {{ outer_bridge }}:
      # 바깥 구역. fw 쌍의 바깥 NIC와 io가 붙음. 포트가 없어도(io 미연결, fw 생성 전) 주소를 가짐
      interfaces: [{{ 'orbit-outer' if outer_if else '' }}]
      dhcp4: false
      optional: true
      addresses:
        - {{ outer_ip }}/{{ lan_prefix }}
      routes:
        # 관리 구역(직접)과 관측 구역(위 경로) 밖의 구역은 방화벽 바깥 VIP로
        - to: {{ lan_net }}
          via: {{ fw_outer_vip }}
      parameters:
        stp: false
        forward-delay: 0
{% endif %}
{% if wifi_if %}
  wifis:
    {{ wifi_if }}:
{% if wifi_ip == 'dhcp' %}
      dhcp4: true
      dhcp4-overrides:
        route-metric: {{ metric_backup if net_role == 'fw' else metric_main }}
{% else %}
      dhcp4: false
      addresses: [{{ wifi_ip }}/{{ wifi_prefix }}]
      routes:
        - to: default
          via: {{ wifi_gw }}
          metric: {{ metric_backup if net_role == 'fw' else metric_main }}
      nameservers:
        addresses: [{{ dns | join(', ') }}]
{% endif %}
      access-points:
        "{{ wifi_ssid }}":
          auth:
            key-management: "psk"
            password: "{{ wifi_psk }}"
{% endif %}
