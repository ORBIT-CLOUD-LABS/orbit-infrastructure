#!/bin/bash
# {{ ansible_managed }}
# Vault Raft 스냅샷을 S3로 업로드함. systemd timer(vault-snapshot.timer)가 하루 1회 실행
#
# 동작 요약
#   - AppRole로 단기 토큰을 발급받아 스냅샷을 저장하고 종료 시 토큰을 폐기함
#   - 업로드 전 스냅샷 크기와 gzip·tar 무결성을 검사하고, 실패 시 업로드하지 않음
#   - 업로드와 S3 크기 확인이 끝난 뒤 로컬 임시 파일을 삭제함
#   - 자격증명은 systemd EnvironmentFile로 주입받음
#     {{ hvault_snapshot_aws_env }}      AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION
#     {{ hvault_snapshot_approle_env }}  VAULT_SNAPSHOT_ROLE_ID / VAULT_SNAPSHOT_SECRET_ID
set -euo pipefail
umask 077

VAULT_ADDR="https://127.0.0.1:{{ hvault_port }}"
VAULT_CACERT="{{ hvault_tls_dir }}/vault-ca.crt"
export VAULT_ADDR VAULT_CACERT

BUCKET="{{ hvault_snapshot_bucket }}"
PREFIX="{{ hvault_snapshot_prefix }}"
MIN_BYTES="{{ hvault_snapshot_min_bytes }}"
WORK_DIR="{{ hvault_snapshot_work_dir }}"
METRIC_DIR="{{ hvault_snapshot_metric_dir }}"

log()  { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
die()  { log "FAIL $*"; exit 1; }

TOKEN=""
SNAP=""

cleanup() {
  if [[ -n "$TOKEN" ]]; then
    VAULT_TOKEN="$TOKEN" vault token revoke -self >/dev/null 2>&1 || log "경고: 토큰 폐기 실패"
  fi
  if [[ -n "$SNAP" && "${DONE:-0}" == "1" ]]; then
    rm -f -- "$SNAP"
  fi
  if [[ "${DONE:-0}" != "1" ]]; then
    metric 0 "${SIZE:-0}"
  fi
}
trap cleanup EXIT

# node-exporter textfile collector 경로가 있으면 실행 결과를 기록함
metric() {
  local ok="$1" size="$2"
  [[ -d "$METRIC_DIR" ]] || return 0
  local f="$METRIC_DIR/vault_snapshot.prom"
  {
    echo '# HELP vault_snapshot_success 마지막 스냅샷 백업 성공 여부 (1=성공)'
    echo '# TYPE vault_snapshot_success gauge'
    echo "vault_snapshot_success $ok"
    echo '# HELP vault_snapshot_last_run_timestamp_seconds 마지막 실행 시각'
    echo '# TYPE vault_snapshot_last_run_timestamp_seconds gauge'
    echo "vault_snapshot_last_run_timestamp_seconds $(date +%s)"
    echo '# HELP vault_snapshot_size_bytes 마지막 스냅샷 크기'
    echo '# TYPE vault_snapshot_size_bytes gauge'
    echo "vault_snapshot_size_bytes $size"
  } > "$f.tmp" && mv -- "$f.tmp" "$f"
}

# 1. 사전 확인
[[ -n "${VAULT_SNAPSHOT_ROLE_ID:-}"   ]] || die "VAULT_SNAPSHOT_ROLE_ID 없음 ({{ hvault_snapshot_approle_env }} 확인)"
[[ -n "${VAULT_SNAPSHOT_SECRET_ID:-}" ]] || die "VAULT_SNAPSHOT_SECRET_ID 없음"
[[ -n "${AWS_ACCESS_KEY_ID:-}"        ]] || die "AWS_ACCESS_KEY_ID 없음 ({{ hvault_snapshot_aws_env }} 확인)"

SEALED=$(vault status -format=json 2>/dev/null | jq -r '.sealed // "unknown"' || echo unknown)
[[ "$SEALED" == "false" ]] || die "Vault가 sealed 또는 응답 없음 (sealed=$SEALED). unseal 후 다시 실행"

mkdir -p -- "$WORK_DIR"

# 2. AppRole 로그인 (인자 노출 방지를 위해 임시 파일로 전달)
LOGIN_BODY=$(mktemp "$WORK_DIR/login.XXXXXX.json")
jq -n --arg r "$VAULT_SNAPSHOT_ROLE_ID" --arg s "$VAULT_SNAPSHOT_SECRET_ID" \
  '{role_id: $r, secret_id: $s}' > "$LOGIN_BODY"

TOKEN=$(vault write -field=token auth/approle/login @"$LOGIN_BODY" 2>/dev/null) || {
  rm -f -- "$LOGIN_BODY"
  die "AppRole 로그인 실패. secret_id 또는 CIDR 제한 확인"
}
rm -f -- "$LOGIN_BODY"
export VAULT_TOKEN="$TOKEN"
log "AppRole 로그인 성공"

# 3. 스냅샷 저장
TS=$(date -u +%Y%m%dT%H%M%SZ)
SNAP="$WORK_DIR/vault-$TS.snap"

vault operator raft snapshot save "$SNAP" || die "스냅샷 저장 실패"

# 4. 업로드 전 무결성 확인
[[ -f "$SNAP" ]] || die "스냅샷 파일이 없음"
SIZE=$(stat -c %s -- "$SNAP")
(( SIZE >= MIN_BYTES )) || die "스냅샷 크기가 기준 미달 (${SIZE}B < ${MIN_BYTES}B). 업로드하지 않음"

gzip -t -- "$SNAP" 2>/dev/null || die "스냅샷 gzip 검사 실패. 업로드하지 않음"
tar -tzf "$SNAP" >/dev/null 2>&1 || die "스냅샷 tar 목록 확인 실패. 업로드하지 않음"

log "스냅샷 검사 통과 (${SIZE}B)"

# 5. S3 업로드
KEY="$PREFIX$(basename -- "$SNAP")"
aws s3api put-object \
  --bucket "$BUCKET" \
  --key "$KEY" \
  --body "$SNAP" \
  --output text --query ETag >/dev/null || die "S3 업로드 실패 (s3://$BUCKET/$KEY)"

log "uploaded s3://$BUCKET/$KEY (${SIZE}B)"

# 6. 업로드 객체 크기 확인
REMOTE=$(aws s3api head-object --bucket "$BUCKET" --key "$KEY" \
           --query ContentLength --output text) || die "업로드 후 head-object 실패"
[[ "$REMOTE" == "$SIZE" ]] || die "크기 불일치 (로컬 ${SIZE}B / S3 ${REMOTE}B)"

DONE=1
metric 1 "$SIZE"
log "완료"
