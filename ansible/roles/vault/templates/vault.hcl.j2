# {{ ansible_managed }}
# Vault 서버 (astra). 초기화와 unseal은 수동
ui            = false
disable_mlock = true     # Raft는 mlock을 끄도록 권장 (메모리 맵 파일을 씀)
api_addr      = "{{ hvault_addr }}"
cluster_addr  = "https://{{ hvault_cluster_addr }}"
{% if hvault_allow_generate_root | bool %}

# 임시로 켬: 토큰 없이 unseal 키 정족수로 root를 다시 만들 수 있게 함. 작업이 끝나면 끔 (docs/vault.md)
enable_unauthenticated_access = ["generate-root"]
{% endif %}

storage "raft" {
  path    = "{{ hvault_data_dir }}"
  node_id = "{{ inventory_hostname }}"
}

# 모든 IPv4 주소에서 받고, 받을 인터페이스는 방화벽에서 제한함 (tailscale0은 부팅 때 늦게 생김)
listener "tcp" {
  address         = "0.0.0.0:{{ hvault_port }}"
  cluster_address = "{{ hvault_cluster_addr }}"
  tls_cert_file   = "{{ hvault_tls_dir }}/vault.crt"
  tls_key_file    = "{{ hvault_tls_dir }}/vault.key"
  tls_min_version = "tls12"
}
