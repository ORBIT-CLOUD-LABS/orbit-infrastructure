#!/bin/bash
# {{ ansible_managed }}
# Vault Raft 스냅샷 수동 복원 스크립트
#
# 주의사항
#   - 스냅샷 복원은 현재 Vault 데이터를 스냅샷 시점 데이터로 덮어씀
#   - 복원 실행 전 현재 상태의 스냅샷을 먼저 백업하고 확인 입력을 받음
#   - unseal 키와 /opt/vault/tls 파일은 스냅샷에 포함되지 않으므로 기존 값을 유지함
#
# 사용법
#   export VAULT_TOKEN=<root token>     # read -rs VAULT_TOKEN 으로 입력
#   {{ hvault_snapshot_restore_bin }} /path/to/vault-<ts>.snap
#   {{ hvault_snapshot_restore_bin }} --from-s3 vault-<ts>.snap
#   {{ hvault_snapshot_restore_bin }} --list
set -euo pipefail
umask 077

VAULT_ADDR="https://127.0.0.1:{{ hvault_port }}"
VAULT_CACERT="{{ hvault_tls_dir }}/vault-ca.crt"
export VAULT_ADDR VAULT_CACERT

BUCKET="{{ hvault_snapshot_bucket }}"
PREFIX="{{ hvault_snapshot_prefix }}"
WORK_DIR="{{ hvault_snapshot_work_dir }}"

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
die() { log "FAIL $*"; exit 1; }

usage() {
  sed -n '2,15p' "$0" | sed 's/^# \?//'
  exit 1
}

[[ $# -ge 1 ]] || usage

s3() { set -a; . "{{ hvault_snapshot_aws_env }}"; set +a; aws "$@"; }

if [[ "$1" == "--list" ]]; then
  s3 s3api list-objects-v2 --bucket "$BUCKET" --prefix "$PREFIX" \
    --query 'sort_by(Contents,&LastModified)[].[LastModified,Size,Key]' --output text
  exit 0
fi

SNAP=""
if [[ "$1" == "--from-s3" ]]; then
  [[ $# -eq 2 ]] || usage
  mkdir -p -- "$WORK_DIR"
  SNAP="$WORK_DIR/restore-$2"
  log "S3에서 다운로드: s3://$BUCKET/$PREFIX$2"
  s3 s3api get-object --bucket "$BUCKET" --key "$PREFIX$2" "$SNAP" >/dev/null \
    || die "다운로드 실패"
else
  SNAP="$1"
fi

[[ -f "$SNAP" ]] || die "파일이 없음: $SNAP"
[[ -n "${VAULT_TOKEN:-}" ]] || die "VAULT_TOKEN이 없음 (root token 필요)"

# 1. 스냅샷 파일 무결성 확인
gzip -t -- "$SNAP" 2>/dev/null || die "올바른 gzip 파일이 아님"
tar -tzf "$SNAP" >/dev/null 2>&1 || die "tar 아카이브를 읽을 수 없음"
SIZE=$(stat -c %s -- "$SNAP")
log "복원 대상: $SNAP (${SIZE}B)"

SEALED=$(vault status -format=json 2>/dev/null | jq -r '.sealed // "unknown"' || echo unknown)
[[ "$SEALED" == "false" ]] || die "Vault가 sealed 또는 응답 없음 (sealed=$SEALED)"

# 2. 복원 전 현재 상태 백업
mkdir -p -- "$WORK_DIR"
PRE="$WORK_DIR/pre-restore-$(date -u +%Y%m%dT%H%M%SZ).snap"
log "복원 전 현재 상태 스냅샷 저장: $PRE"
vault operator raft snapshot save "$PRE" || die "복원 전 스냅샷 저장 실패로 중단함"
gzip -t -- "$PRE" 2>/dev/null || die "복원 전 스냅샷 파일 검증 실패로 중단함"
log "복원 전 스냅샷 저장 완료 ($(stat -c %s -- "$PRE")B)"

# 3. 사용자 확인
cat <<MSG

  이 작업은 Vault 데이터를 "$SNAP" 시점으로 덮어씁니다.
  스냅샷 시점 이후에 변경된 시크릿, 정책, 로그인 매핑은 사라집니다.
  복원 전 백업 파일: $PRE

MSG
read -r -p "  계속하려면 restore 입력: " ANSWER
[[ "$ANSWER" == "restore" ]] || die "취소됨"

# 4. 복원 실행
vault operator raft snapshot restore "$SNAP" || die "복원 실패. 사전 백업 파일: $PRE"
log "복원 완료"

# 5. 복원 후 상태 확인
SEALED=$(vault status -format=json 2>/dev/null | jq -r '.sealed // "unknown"' || echo unknown)
log "sealed=$SEALED (true인 경우 기존 unseal 키로 unseal 필요)"

log "SSH CA 공개키 조회"
vault read -field=public_key {{ hvault_ssh_mount }}/config/ca >/dev/null \
  && log "SSH CA 정상" || log "경고: SSH CA 조회 실패"

log "사전 백업 파일 보관 위치: $PRE"
