# {{ ansible_managed }}
# orbit-vault-backup IAM 사용자. vault/ 접두사에 Get/Put만 있고 DeleteObject는 없다
# 값은 ansible-vault로 암호화한 inventory/group_vars/all/vault.yml에 있다
AWS_ACCESS_KEY_ID={{ vault_snapshot_aws_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ vault_snapshot_aws_secret_access_key }}
AWS_DEFAULT_REGION={{ hvault_snapshot_region }}
AWS_EC2_METADATA_DISABLED=true
