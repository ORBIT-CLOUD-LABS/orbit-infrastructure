# {{ ansible_managed }}
# k3s 앱 공용 읽기 (ESO). 인프라 구역(orbit/infra)과 metadata 목록 조회, 쓰기는 허용하지 않음
path "{{ hvault_kv_mount }}/data/{{ hvault_kv_k3s_prefix }}/*" {
  capabilities = ["read"]
}

# default 정책을 붙이지 않으므로 ESO의 자기 토큰 확인·정리 권한만 명시
path "auth/token/lookup-self" {
  capabilities = ["read"]
}

path "auth/token/revoke-self" {
  capabilities = ["update"]
}
