# {{ ansible_managed }}
# Elasticsearch 단일 노드 (efk)
cluster.name: {{ efk_cluster_name }}
node.name: {{ inventory_hostname }}
discovery.type: single-node

path.data: {{ efk_es_data_dir }}
path.logs: {{ efk_es_log_dir }}

network.host: {{ efk_es_host }}
http.port: 9200

# 패키지의 보안 자동 구성을 막으려면 이 키가 있어야 함 (설정 파일을 패키지보다 먼저 둠)
# TLS와 계정을 구성하기 전 단계. efk 안(127.0.0.1)에서만 열려 있음
xpack.security.enabled: false
