# {{ ansible_managed }}
route:
  receiver: {{ 'slack' if alertmanager_slack_webhook | length > 0 else 'blackhole' }}
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: blackhole
{% if alertmanager_slack_webhook | length > 0 %}
  - name: slack
    slack_configs:
      - api_url: "{{ alertmanager_slack_webhook }}"
        channel: "{{ alertmanager_slack_channel }}"
        send_resolved: true
        title: '[{{ '{{' }} .Status | toUpper {{ '}}' }}] {{ '{{' }} .CommonLabels.alertname {{ '}}' }}'
        text: '{{ '{{' }} range .Alerts {{ '}}' }}{{ '{{' }} .Annotations.summary {{ '}}' }}{{ '{{' }} "\n" {{ '}}' }}{{ '{{' }} end {{ '}}' }}'
{% endif %}
