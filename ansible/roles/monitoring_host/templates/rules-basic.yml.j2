# {{ ansible_managed }}
# 기본 규칙 (Slack 연결 테스트용). 서비스 알림 규칙은 트랙 C가 이 폴더에 추가한다.
groups:
  - name: orbit-basic
    rules:
      - alert: InstanceDown
        expr: up == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} 수집 실패 ({{ '{{' }} $labels.job {{ '}}' }})"

      - alert: DiskAlmostFull
        expr: (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes) < 0.15
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} {{ '{{' }} $labels.mountpoint {{ '}}' }} 여유 15% 미만"
